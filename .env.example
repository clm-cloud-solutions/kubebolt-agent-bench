# Clave de Vercel AI Gateway (Vercel → AI Gateway → API Keys)
AI_GATEWAY_API_KEY=vck_xxx

# Opcional: pasos máximos por run antes de cortar (default 25)
BENCH_MAX_STEPS=25

# Opcional: clave de Anthropic para correr Claude con el Agent SDK (npm run agent-sdk-run); ver docs/agent-sdk-foundry.md
# ANTHROPIC_API_KEY=sk-ant-...

# Opcional: clave de OpenAI para correr GPT con el OpenAI Agents SDK (npm run openai-agent-run); va directo a OpenAI, no por el gateway
# OPENAI_API_KEY=sk-...

# Opcional: 0 desactiva el recordatorio final cuando el modelo cierra el turno sin entregar (default 1)
BENCH_NUDGE=1

# Opcional: directorio de resultados que sirve la UI (default results). results-public trae los runs publicados.
# BENCH_RESULTS_DIR=results-public
